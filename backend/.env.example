# Copie este archivo a .env y complete los valores.
# NUNCA suba el archivo .env al repositorio: contiene claves.

# Puerto local de la API
PORT=3000

# Supabase (se completan cuando se conecte la base de datos)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# La clave de servicio da acceso total: solo en el servidor, nunca en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Cadena de conexion directa a PostgreSQL
DATABASE_URL=